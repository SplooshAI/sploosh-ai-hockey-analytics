# Deployment settings for the Oracle Cloud VM. Copy to .env.deploy (gitignored,
# never committed) and fill in. See docs/deployment/oracle-vm.md.

# Public IPv4 address of the VM, from the OCI Console
# (Compute > Instances > sploosh.ai-vm). Not static by default — update it if
# the instance is ever stopped and started or recreated.
HOCKEY_VM_IP=

# Public hostname the Cloudflare Tunnel serves, used by `npm run deploy:status`
# to check the live URL. See docs/deployment/cloudflare-tunnel.md.
HOCKEY_PUBLIC_HOSTNAME=hockey-preview.sploosh.ai

# Cloudflare Tunnel token. Treat it like a password: anyone holding it can
# point this tunnel anywhere. Rotate it from the tunnel's Overview tab in the
# Cloudflare dashboard if it is ever exposed.
TUNNEL_TOKEN=
